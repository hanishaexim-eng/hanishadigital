{
  "name": "hanisha-digital",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:tailwind": "tailwindcss -i ./src/tailwind.input.css -o ./src/tailwind.generated.css --minify",
    "watch:tailwind": "tailwindcss -i ./src/tailwind.input.css -o ./src/tailwind.generated.css --watch",
    "prebuild": "npm run build:tailwind",
    "start": "npm run build:tailwind && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2"
  }
}
